* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  min-height: 100%;
}

body {
  font-family: Arial, Helvetica, sans-serif;
}

/* ================= HOME ================= */

.home-page {
  min-height: 100vh;
  background-color: #172033;
}

/* ================= NAVBAR ================= */

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 72px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 6%;

  background: rgba(10, 18, 32, 0.9);

  z-index: 1000;
}

.logo {
  color: white;
  font-size: 28px;
  font-weight: 800;
}

.login-btn {
  border: none;
  background: white;
  color: #123c9c;

  padding: 10px 25px;
  border-radius: 8px;

  font-size: 15px;
  font-weight: 600;

  cursor: pointer;
}

/* ================= HERO ================= */

.hero {
  min-height: 100vh;

  display: flex;
  align-items: center;

  gap: 6%;

  padding: 120px 5% 60px;

  background-image: url("./assets/hero-road.jpg");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  position: relative;
}

/* Dark overlay */

.hero::before {
  content: "";

  position: absolute;
  inset: 0;

  background: rgba(0, 0, 0, 0.45);

  z-index: 0;
}

/* Keep content above overlay */

.search-card,
.hero-content {
  position: relative;
  z-index: 1;
}

/* ================= SEARCH CARD ================= */

.search-card {
  width: 395px;
  flex-shrink: 0;

  background: white;

  padding: 28px;

  border-radius: 14px;

  box-shadow: 0 15px 45px rgba(0, 0, 0, 0.3);

  text-align: left;
}

.search-card h2 {
  font-size: 23px;
  margin-bottom: 24px;
  color: #111827;
  text-align: left;
}

.form-group {
  margin-bottom: 16px;

  text-align: left;
}

.form-group label {
  display: block;

  margin-bottom: 7px;

  font-size: 14px;
  font-weight: 600;

  color: #244a96;

  text-align: left;
}

.form-group input,
.form-group select {
  width: 100%;
  height: 48px;

  border: 1px solid #dce3ec;
  border-radius: 9px;

  padding: 0 13px;

  font-size: 14px;

  color: #333;
  background: #f5f7fa;

  outline: none;

  text-align: left;
}

.form-group input:focus,
.form-group select:focus {
  border-color: #1769e0;
  background: white;
}

/* ================= DATE ================= */

.date-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

/* ================= SEARCH BUTTON ================= */

.search-btn {
  width: 100%;
  height: 52px;

  margin-top: 4px;

  border: none;
  border-radius: 9px;

  background: linear-gradient(
    90deg,
    #0969e8,
    #1510b8
  );

  color: white;

  font-size: 16px;
  font-weight: 700;

  cursor: pointer;
}

/* ================= HERO CONTENT ================= */

.hero-content {
  flex: 1;
  color: white;

  text-align: left;
}

.hero-content h1 {
  font-size: clamp(45px, 5vw, 76px);
  line-height: 1.08;
  font-weight: 800;

  margin-bottom: 22px;

  text-align: left;
}

.hero-content p {
  max-width: 650px;

  font-size: 18px;
  line-height: 1.6;

  color: #e0e4eb;

  margin-bottom: 30px;

  text-align: left;
}

/* ================= FEATURES ================= */

.feature-bar {
  display: flex;
  align-items: center;

  width: fit-content;

  background: rgba(15, 15, 15, 0.55);

  padding: 14px 20px;

  border-radius: 10px;
}

.feature {
  display: flex;
  align-items: center;

  gap: 9px;

  font-size: 14px;
  font-weight: 600;

  white-space: nowrap;
}

.feature span {
  color: #ffc400;

  font-size: 21px;
  font-weight: bold;
}

.divider {
  width: 1px;
  height: 25px;

  background: rgba(255, 255, 255, 0.4);

  margin: 0 18px;
}

/* ================= TABLET ================= */

@media (max-width: 1000px) {

  .hero {
    min-height: 100vh;

    flex-direction: column;

    justify-content: center;
    align-items: center;

    gap: 30px;

    padding: 110px 30px 50px;

    text-align: center;
  }

  /* ---------- HERO CONTENT ---------- */

  .hero-content {
    order: 1;

    width: 100%;

    text-align: center;
  }

  .hero-content h1 {
    font-size: clamp(42px, 6vw, 58px);

    line-height: 1.1;

    margin-bottom: 18px;

    text-align: center;
  }

  .hero-content p {
    max-width: 650px;

    margin: 0 auto;

    font-size: 17px;

    color: #e0e4eb;

    text-align: center;
  }

  /* ---------- SEARCH CARD ---------- */

  .search-card {
    order: 2;

    width: min(100%, 500px);

    text-align: left;
  }

  .search-card h2 {
    text-align: left;
  }

  .form-group {
    text-align: left;
  }

  .form-group label {
    text-align: left;
  }

  /* ---------- HIDE FEATURES ---------- */

  .feature-bar {
    display: none;
  }
}

/* ================= MOBILE ================= */

@media (max-width: 700px) {

  .home-page {
    background-color: #f4f7fb;
  }

  /* ---------- NAVBAR ---------- */

  .navbar {
    height: 64px;

    padding: 0 20px;

    background: white;
  }

  .logo {
    color: #123c9c;

    font-size: 24px;
  }

  .login-btn {
    background: #123c9c;
    color: white;

    padding: 9px 20px;
  }

  /* ---------- HERO ---------- */

  .hero {
    min-height: 100vh;

    flex-direction: column;

    align-items: center;

    padding: 95px 18px 35px;

    gap: 28px;

    text-align: center;
  }

  /* ---------- HERO CONTENT ---------- */

  .hero-content {
    order: 1;

    width: 100%;

    text-align: center;

    color: white;
  }

  .hero-content h1 {
    font-size: clamp(32px, 9vw, 42px);

    line-height: 1.12;

    margin-bottom: 16px;

    text-align: center;
  }

  .hero-content p {
    max-width: 500px;

    margin: 0 auto;

    font-size: clamp(14px, 4vw, 16px);

    line-height: 1.55;

    color: white;

    text-align: center;
  }

  /* ---------- SEARCH CARD ---------- */

  .search-card {
    order: 2;

    width: 100%;

    padding: 22px;

    text-align: left;
  }

  .search-card h2 {
    text-align: left;
  }

  .form-group {
    text-align: left;
  }

  .form-group label {
    text-align: left;
  }

  .form-group input,
  .form-group select {
    text-align: left;
  }

  /* ---------- FEATURES HIDDEN ---------- */

  .feature-bar {
    display: none;
  }

  /* ---------- DATE ---------- */

  .date-row {
    grid-template-columns: 1fr;

    gap: 0;
  }
}
